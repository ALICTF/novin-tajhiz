# آدرس نهایی سایت — در فید ترب، sitemap و تگ‌های اشتراک‌گذاری استفاده می‌شود.
# روی لیارا تا قبل از اتصال دامنه، زیردامنه لیارا را بگذارید.
NEXT_PUBLIC_SITE_URL="https://novintajhiz.org"

# اتصال دیتابیس. برای توسعه محلی با داکر:  docker compose up -d db
DATABASE_URL="postgresql://novin:novin@localhost:5432/novintajhiz?schema=public"

# رمز ورود به پنل مدیریت. حتماً قبل از انتشار عوضش کن.
ADMIN_PASSWORD="your-admin-password"

# کلید امضای کوکی نشست. یک رشته تصادفی طولانی بگذار.
ADMIN_SESSION_SECRET="a-long-random-string"

# مسیر ذخیره فایل‌های آپلودی روی دیسک. روی سرور باید یک volume دائمی باشد.
UPLOAD_DIR="./uploads"

# --- اختیاری: فضای ابری S3-سازگار (لیارا، آروان، ...) ---
# اگر پر شوند، آپلودها به‌جای دیسک محلی آنجا می‌روند. روی هاست‌هایی که
# فایل‌سیستمشان با هر استقرار پاک می‌شود، این تنها راه امن است.
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_REGION="us-east-1"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_PUBLIC_URL=""

# --- پیامک کاوه‌نگار ---
# تا وقتی کلید خالی باشد، سایت کامل کار می‌کند و فقط پیامکی ارسال نمی‌شود.
KAVENEGAR_API_KEY=""
# خط فرستنده. خالی بگذارید تا خط پیش‌فرض حساب استفاده شود.
KAVENEGAR_SENDER=""
# شماره‌ای که پیامک «سفارش جدید» به آن می‌رود.
# خالی بگذارید تا شماره اصلی مجموعه از src/lib/data/site.ts استفاده شود.
ADMIN_SMS_RECIPIENT=""

# --- پشتیبان‌گیری خودکار ---
# نسخه‌ها در پوشه ./backups روی سرور ذخیره می‌شوند.
BACKUP_RETENTION_DAYS="14"
BACKUP_INTERVAL_HOURS="24"
